# Optional: configure here, or enter a key in the local app's Settings panel.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional search integration. Without a key, the app tries public Bing RSS.
TAVILY_API_KEY=

# Both values enable persistent Turso storage. Otherwise local SQLite is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for production. Use a strong shared password (16+ characters).
APP_ACCESS_PASSWORD=
# Independent random secret (32+ characters); never use the NVIDIA/Turso token.
APP_SESSION_SECRET=
# Exact public HTTPS origin, e.g. https://your-app.onrender.com
# Falls back to Render's RENDER_EXTERNAL_URL when available.
APP_ORIGIN=
